{
  "name": "doclight",
  "version": "0.1.0",
  "private": true,
  "description": "DocLight —— 服务于人阅读、同时 AI 原生友好的零构建开源文档站引擎",
  "type": "module",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@10.14.0",
  "scripts": {
    "verify": "node scripts/verify.mjs",
    "verify:lint": "node scripts/run-check.mjs lint",
    "verify:typecheck": "node scripts/run-check.mjs typecheck",
    "verify:test": "node scripts/run-check.mjs test",
    "verify:size": "node scripts/run-check.mjs size",
    "verify:contract": "node scripts/run-check.mjs contract",
    "verify:visual": "playwright test -c playwright.visual.config.ts",
    "verify:visual:update": "playwright test -c playwright.visual.config.ts --update-snapshots",
    "verify:e2e": "node scripts/run-check.mjs e2e",
    "spec:check": "node scripts/run-check.mjs spec",
    "build": "node scripts/build.mjs",
    "build:display": "node scripts/build-display.mjs",
    "review": "node scripts/review.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.62.0",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^3.0.0",
    "eslint": "^9.0.0",
    "globals": "^15.0.0",
    "prettier": "^3.3.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.0.0"
  }
}
